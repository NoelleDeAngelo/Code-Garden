generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model user {
  id    String     @id @default(uuid())
  name  String
  email String  @unique
  password String
  debtTask debtTask[]
  learningTask learningTask[]
}

// The tasks are stored in separate tables to keep the application scalable. This allows new task types or type specific fields to be easily added in the future.

model debtTask{
  id Int @id @default(autoincrement())
  title String
  description String?
  isCompleted Boolean @default(false)
  createdAt DateTime @default(now())
  completedAt DateTime?
  iconName String
  iconXLoc String
  iconYLoc String
  userId String
  user user @relation(fields: [userId], references: [id])
}

model learningTask{
  id Int @id @default(autoincrement())
  title String
  description String?
  isCompleted Boolean @default(false)
  createdAt DateTime @default(now())
  completedAt DateTime?
  iconName String
  iconXLoc String
  iconYLoc String
  userId String
  user user @relation(fields: [userId], references: [id])
}